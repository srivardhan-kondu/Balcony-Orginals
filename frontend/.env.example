# Copy to frontend/.env.local for local development (it is gitignored).
# On Vercel, set these in Project → Settings → Environment Variables instead.
#
# Both are inlined at build time, so changing either on Vercel requires a redeploy.

# Base URL of the Render backend, with NO trailing slash and NO /api suffix
# (the client appends /api itself).
#   Production: https://balcony-originals-api.onrender.com
#   Local:      http://localhost:8000
#
# It is read twice, for two different jobs. On the server it is the build-time
# read that puts the archive into the generated HTML; in the browser it is the
# refresh that keeps the live API as the source of truth. Both fall back to the
# static archive in lib/fallback.js, so an unset or unreachable backend degrades
# to the site as shipped rather than to an empty page.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# The site's own origin, with NO trailing slash. Canonical tags, og:url, the
# sitemap and the structured data are all absolute and are built from this — get
# it wrong and every canonical on the site points at the wrong domain.
NEXT_PUBLIC_SITE_URL=https://balconyoriginals.com
