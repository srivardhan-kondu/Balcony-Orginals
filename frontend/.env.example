# Copy to frontend/.env for local development (it is gitignored).
# On Vercel, set this in Project → Settings → Environment Variables instead.
#
# Base URL of the Render backend, with NO trailing slash and NO /api suffix
# (the client appends /api itself).
#   Production: https://balcony-originals-api.onrender.com
#   Local:      http://localhost:8000
#
# NOTE: this is inlined at build time, so changing it on Vercel requires a redeploy.
REACT_APP_BACKEND_URL=http://localhost:8000
