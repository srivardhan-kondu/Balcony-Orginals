# Copy to backend/.env for local development (it is gitignored).
# On Render these are set as environment variables in the dashboard instead.

# MongoDB connection string. Leave blank to boot the API without a database —
# data endpoints will return 503 until this is filled in.
# Atlas format: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=

DB_NAME=balcony_originals

# Comma-separated allowed origins for the browser. Use "*" locally.
# In production set this to your Vercel domain(s), e.g.
# CORS_ORIGINS=https://balconyoriginals.vercel.app,https://www.balconyoriginals.com
CORS_ORIGINS=*

# Optional: regex to allow Vercel preview URLs as well.
# CORS_ORIGIN_REGEX=^https://balcony-originals-.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# Resend — every story submission and contact message is emailed here.
# Keep the real key out of git: put it in backend/.env locally and in Render's
# dashboard in production.
RESEND_API_KEY=
NOTIFY_EMAIL=balcony.originals@gmail.com
# Until a domain is verified in Resend, the sender must be onboarding@resend.dev
# and Resend only delivers to the email that owns the Resend account.
RESEND_FROM=Balcony Originals <onboarding@resend.dev>
